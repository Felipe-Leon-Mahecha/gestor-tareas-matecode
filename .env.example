# Firebase (cliente) - estas variables SÍ llegan al navegador, por eso usan prefijo VITE_
# No son secretos reales: Firebase se protege con reglas de Firestore/Auth, no con la apiKey.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# AWS SES (solo servidor - Vercel Functions en /api). SIN prefijo VITE_ para que NUNCA se expongan al cliente.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
SES_FROM_EMAIL=
